# Operating system and editor artifacts
.DS_Store
.history/

# Local configuration and credentials
.env
.env.*
!.env.example
config/runtime.env
config/runtime.env.tmp

# JavaScript dependencies and build artifacts
node_modules/
.pnpm-store/
dist/
*.tsbuildinfo

# JavaScript test artifacts
coverage/
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/

# Python dependencies, bytecode, and tool caches
.venv/
.pytest_cache/
apps/parser-worker/tests/.pytest-tmp/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]

# Runtime data and private evaluation results
data/raw-docs/*

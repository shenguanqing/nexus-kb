#!/bin/sh
set -eu

for secret_name in ${NEXUS_FILE_ENV_NAMES:-}; do
  case "$secret_name" in
    *[!A-Z0-9_]*|'')
      echo "Invalid secret environment name" >&2
      exit 78
      ;;
  esac

  secret_file=$(printenv "${secret_name}_FILE" || true)
  if [ -z "$secret_file" ]; then
    continue
  fi
  case "$secret_file" in
    /run/secrets/*) ;;
    *)
      echo "Secret file for $secret_name must be under /run/secrets" >&2
      exit 78
      ;;
  esac
  if [ ! -f "$secret_file" ] || [ ! -r "$secret_file" ]; then
    echo "Secret file for $secret_name is unavailable" >&2
    exit 78
  fi
  secret_size=$(wc -c <"$secret_file")
  if [ "$secret_size" -gt 1048576 ]; then
    echo "Secret file for $secret_name exceeds 1 MiB" >&2
    exit 78
  fi
  secret_value=$(cat "$secret_file")
  export "$secret_name=$secret_value"
  unset "${secret_name}_FILE"
done

unset NEXUS_FILE_ENV_NAMES
exec "$@"

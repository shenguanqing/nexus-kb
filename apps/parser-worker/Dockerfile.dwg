FROM python:3.11.13-slim-bookworm

ARG ODA_DEB=apps/parser-worker/vendor/oda/oda-file-converter.deb

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DO_NOT_TRACK=true \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# The ODA package is obtained by the deployment owner under its own licence.  It
# is intentionally ignored by Git and installed only in this derived DWG image.
COPY ${ODA_DEB} /tmp/oda-file-converter.deb
# ODA's Debian package currently expects the older SONAME; Debian 12 ships
# the compatible libxcb-util.so.1 implementation.
RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        /tmp/oda-file-converter.deb \
        fontconfig \
        libfreetype6 \
        libglib2.0-0 \
        libgl1 \
        libpng16-16 \
        libxcb1 \
        libxcb-util1 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-render-util0 \
        libxcb-render0 \
        libxcb-shape0 \
        libxcb-xkb1 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        poppler-utils \
        tesseract-ocr \
        tesseract-ocr-chi-sim \
        tesseract-ocr-eng \
        xauth \
        xvfb \
    && ln -s /usr/lib/x86_64-linux-gnu/libxcb-util.so.1 /usr/lib/x86_64-linux-gnu/libxcb-util.so.0 \
    && rm -rf /var/lib/apt/lists/* /tmp/oda-file-converter.deb

COPY apps/parser-worker/requirements.lock ./requirements.lock
# The ODA image is linux/amd64 even on Apple Silicon. Install the explicit CPU
# PyTorch wheels first so the regular resolver cannot pull multi-gigabyte CUDA
# runtime packages from PyPI.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.8.0 \
        torchvision==0.23.0 \
    && pip install \
        --index-url https://pypi.org/simple \
        --retries 10 \
        --timeout 60 \
        -r requirements.lock
COPY --chmod=0755 apps/parser-worker/bin/nexus-download-easyocr-models /usr/local/bin/nexus-download-easyocr-models
RUN mkdir -p /opt/easyocr-models \
    && nexus-download-easyocr-models \
    && useradd --uid 10002 --create-home worker \
    && mkdir -p /data/raw-docs /tmp/parser \
    && chown -R worker:worker /app /tmp/parser /opt/easyocr-models

# Unstructured uses NLTK for PDF text classification. Keep runtime network-free
# by downloading the exact tokenizer/tagger resources into the image.
RUN mkdir -p /opt/nltk_data \
    && NLTK_DATA=/opt/nltk_data python -c "import nltk; [nltk.download(package, download_dir='/opt/nltk_data', quiet=True, raise_on_error=True) for package in ('punkt_tab', 'averaged_perceptron_tagger_eng')]" \
    && chmod -R a-w /opt/nltk_data

COPY --chmod=0755 apps/parser-worker/bin/nexus-oda-file-converter /usr/local/bin/nexus-oda-file-converter
COPY --chmod=0755 apps/parser-worker/bin/nexus-parser-worker-entrypoint /usr/local/bin/nexus-parser-worker-entrypoint
COPY --chown=worker:worker apps/parser-worker/app ./app
USER worker
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/nexus-parser-worker-entrypoint"]
CMD ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]

#!/bin/sh
set -eu

attempt=1
max_attempts=5

while [ "$attempt" -le "$max_attempts" ]; do
  if python -c "import easyocr; easyocr.Reader(['ch_sim','en'], gpu=False, model_storage_directory='/opt/easyocr-models', download_enabled=True, verbose=False)"; then
    exit 0
  fi

  rm -f /opt/easyocr-models/temp.zip
  if [ "$attempt" -eq "$max_attempts" ]; then
    echo "EasyOCR model download failed after ${max_attempts} attempts" >&2
    exit 1
  fi

  echo "EasyOCR model download attempt ${attempt} failed; retrying" >&2
  attempt=$((attempt + 1))
  sleep 2
done

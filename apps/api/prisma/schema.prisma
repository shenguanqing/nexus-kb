generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sensitivity {
  public
  internal
  confidential
}

enum DocumentStatus {
  uploaded
  processing
  prepared
  active
  policy_blocked
  failed
  deleted
}

enum IngestionStatus {
  queued
  parsing
  chunking
  policy_check
  embedding
  indexing
  policy_blocked
  completed
  failed
  deleted
}

enum CloudPolicyDecision {
  allowed
  blocked
}

model Document {
  id            String             @id @db.Uuid
  tenantId      String
  sourceName    String
  storageKey    String             @unique
  mimeType      String
  contentSha256 String
  department    String
  sensitivity   Sensitivity
  ownerId       String
  activeVersion Int?
  status        DocumentStatus     @default(uploaded)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  versions      DocumentVersion[]
  jobs          IngestionJob[]
  chunks        KnowledgeChunk[]
  policyEvents  CloudPolicyEvent[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model DocumentVersion {
  id                     String               @id @db.Uuid
  tenantId               String
  documentId             String               @db.Uuid
  version                Int
  parser                 String?
  parserVersion          String?
  parsedElements         Json?
  warnings               Json?
  chunkCount             Int                  @default(0)
  redactionPolicyVersion String?
  cloudPolicyDecision    CloudPolicyDecision?
  embeddingFingerprint   String?              @db.Char(64)
  vectorCollection       String?
  indexedAt              DateTime?
  createdAt              DateTime             @default(now())
  document               Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([tenantId, documentId])
}

model IngestionJob {
  id                   String             @id @db.Uuid
  tenantId             String
  documentId           String             @db.Uuid
  version              Int
  status               IngestionStatus    @default(queued)
  step                 String             @default("queued")
  attempts             Int                @default(0)
  traceId              String             @db.Uuid
  parserVersion        String?
  embeddingFingerprint String?            @db.Char(64)
  vectorCollection     String?
  warnings             Json?
  errorCode            String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  document             Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  policyEvents         CloudPolicyEvent[]

  @@index([tenantId, status])
  @@index([tenantId, documentId])
}

model KnowledgeChunk {
  id                     String   @id @db.Char(64)
  tenantId               String
  documentId             String   @db.Uuid
  documentVersion        Int
  ordinal                Int
  originalText           String   @db.Text
  redactedText           String   @db.Text
  tokenCount             Int
  page                   Int?
  sheet                  String?
  sectionPath            Json
  elementTypes           Json
  previousChunkId        String?  @db.Char(64)
  nextChunkId            String?  @db.Char(64)
  redactionPolicyVersion String
  redactionSummary       Json
  createdAt              DateTime @default(now())
  document               Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, documentVersion, ordinal])
  @@index([tenantId, documentId, documentVersion])
}

model CloudPolicyEvent {
  id                     String              @id @db.Uuid
  tenantId               String
  documentId             String              @db.Uuid
  documentVersion        Int
  ingestionJobId         String              @db.Uuid
  decision               CloudPolicyDecision
  reasonCode             String
  sensitivity            Sensitivity
  providerId             String?
  region                 String?
  redactionPolicyVersion String
  createdAt              DateTime            @default(now())
  document               Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ingestionJob           IngestionJob        @relation(fields: [ingestionJobId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId, createdAt])
  @@index([tenantId, decision, createdAt])
}

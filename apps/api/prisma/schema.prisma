generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sensitivity {
  public
  internal
  confidential
}

enum DocumentStatus {
  uploaded
  processing
  prepared
  active
  policy_blocked
  failed
  deleting
  deleted
}

enum IngestionStatus {
  queued
  converting
  parsing
  chunking
  policy_check
  embedding
  indexing
  policy_blocked
  completed
  failed
  deleted
}

enum CloudPolicyDecision {
  allowed
  blocked
}

enum DocumentVersionStatus {
  processing
  prepared
  policy_blocked
  active
  superseded
  failed
  deleted
}

model Document {
  id               String             @id @db.Uuid
  tenantId         String
  sourceName       String
  storageKey       String             @unique
  mimeType         String
  contentSha256    String
  deduplicationKey String?            @db.Char(64)
  department       String
  sensitivity      Sensitivity
  ownerId          String
  activeVersion    Int?
  status           DocumentStatus     @default(uploaded)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  versions         DocumentVersion[]
  jobs             IngestionJob[]
  chunks           KnowledgeChunk[]
  policyEvents     CloudPolicyEvent[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, contentSha256, department, sensitivity, ownerId])
}

model DocumentVersion {
  id                     String                @id @db.Uuid
  tenantId               String
  documentId             String                @db.Uuid
  version                Int
  status                 DocumentVersionStatus @default(processing)
  parser                 String?
  parserVersion          String?
  parsedElements         Json?
  warnings               Json?
  chunkCount             Int                   @default(0)
  redactionPolicyVersion String?
  cloudPolicyDecision    CloudPolicyDecision?
  embeddingFingerprint   String?               @db.Char(64)
  vectorCollection       String?
  indexedAt              DateTime?
  activatedAt            DateTime?
  supersededAt           DateTime?
  createdAt              DateTime              @default(now())
  document               Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([tenantId, documentId])
}

model IngestionJob {
  id                   String             @id @db.Uuid
  tenantId             String
  documentId           String             @db.Uuid
  version              Int
  kind                 String             @default("ingestion")
  activateOnComplete   Boolean            @default(true)
  status               IngestionStatus    @default(queued)
  step                 String             @default("queued")
  checkpoint           String             @default("queued")
  attempts             Int                @default(0)
  traceId              String             @db.Uuid
  parserVersion        String?
  embeddingFingerprint String?            @db.Char(64)
  vectorCollection     String?
  warnings             Json?
  errorCode            String?
  errorCategory        String?
  retryable            Boolean            @default(false)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  document             Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  policyEvents         CloudPolicyEvent[]

  @@index([tenantId, status])
  @@index([tenantId, documentId])
}

model DocumentLifecycleAudit {
  id                   String   @id @db.Uuid
  tenantId             String
  userId               String?
  traceId              String   @db.Uuid
  documentId           String   @db.Uuid
  documentVersion      Int?
  ingestionJobId       String?  @db.Uuid
  eventType            String
  outcome              String
  vectorCollection     String?
  embeddingFingerprint String?  @db.Char(64)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, documentId, createdAt])
  @@index([tenantId, eventType, createdAt])
  @@index([traceId])
}

model KnowledgeChunk {
  id                     String   @id @db.Char(64)
  tenantId               String
  documentId             String   @db.Uuid
  documentVersion        Int
  ordinal                Int
  originalText           String   @db.Text
  redactedText           String   @db.Text
  tokenCount             Int
  page                   Int?
  sheet                  String?
  sectionPath            Json
  elementTypes           Json
  previousChunkId        String?  @db.Char(64)
  nextChunkId            String?  @db.Char(64)
  redactionPolicyVersion String
  redactionSummary       Json
  createdAt              DateTime @default(now())
  document               Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, documentVersion, ordinal])
  @@index([tenantId, documentId, documentVersion])
}

model CloudPolicyEvent {
  id                     String              @id @db.Uuid
  tenantId               String
  documentId             String              @db.Uuid
  documentVersion        Int
  ingestionJobId         String              @db.Uuid
  decision               CloudPolicyDecision
  reasonCode             String
  sensitivity            Sensitivity
  providerId             String?
  region                 String?
  redactionPolicyVersion String
  createdAt              DateTime            @default(now())
  document               Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ingestionJob           IngestionJob        @relation(fields: [ingestionJobId], references: [id], onDelete: Cascade)

  @@unique([ingestionJobId])
  @@index([tenantId, documentId, createdAt])
  @@index([tenantId, decision, createdAt])
}

model QueryAudit {
  id                String   @id @db.Uuid
  traceId           String   @unique @db.Uuid
  tenantId          String
  userId            String
  department        String?
  queryLength       Int
  outcome           String
  answerMode        String?
  resultCount       Int      @default(0)
  sourceChunkIds    Json
  embeddingProvider String?
  embeddingModel    String?
  rerankProvider    String?
  rerankModel       String?
  rerankDegraded    Boolean  @default(false)
  llmProvider       String?
  llmModel          String?
  fallbackUsed      Boolean  @default(false)
  errorCode         String?
  durationMs        Int
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
}

model UserDirectoryEntry {
  tenantId            String
  userId              String
  username            String?  @unique
  department          String
  roles               Json
  managedRoles        Json?
  allowedSensitivities Json?
  defaultSensitivity  Sensitivity?
  authSource          String   @default("identity")
  passwordSalt        Bytes?
  passwordDigest      Bytes?
  enabled             Boolean  @default(true)
  lastAuthenticatedAt DateTime @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  @@id([tenantId, userId])
  @@index([tenantId, department, lastAuthenticatedAt])
}

model PasswordAuthSession {
  id        String   @id @db.Uuid
  tokenHash String   @unique @db.Char(64)
  tenantId  String
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([tenantId, userId, expiresAt])
}

model PasswordAuthBootstrap {
  id          String   @id
  completedAt DateTime @default(now()) @db.Timestamptz(3)
}

model DepartmentPolicy {
  tenantId             String
  department           String
  allowedSensitivities Json
  updatedBy            String
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  @@id([tenantId, department])
  @@index([tenantId, updatedAt])
}

model AccessAudit {
  id          String   @id @db.Uuid
  tenantId    String
  actorUserId String
  targetType  String
  targetId    String
  eventType   String
  before      Json
  after       Json
  traceId     String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([tenantId, targetType, targetId, createdAt])
}

model SystemConfigVersion {
  id              String             @id @db.Uuid
  tenantId        String
  version         Int
  status          String             @default("draft")
  encryptedConfig String             @db.Text
  summary         Json
  changedKeys     Json
  changeReason    String             @db.VarChar(500)
  createdBy       String
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  activatedAt     DateTime?          @db.Timestamptz(3)
  deployments     SystemDeployment[] @relation("DeploymentConfigVersion")
  previousFor     SystemDeployment[] @relation("DeploymentPreviousVersion")

  @@unique([tenantId, version])
  @@index([tenantId, status, createdAt])
}

model SystemDeployment {
  id                      String               @id @db.Uuid
  tenantId                String
  configVersionId         String               @db.Uuid
  previousConfigVersionId String?              @db.Uuid
  status                  String               @default("queued")
  services                Json
  requestedBy             String
  traceId                 String               @db.Uuid
  errorCode               String?
  createdAt               DateTime             @default(now()) @db.Timestamptz(3)
  startedAt               DateTime?            @db.Timestamptz(3)
  completedAt             DateTime?            @db.Timestamptz(3)
  configVersion           SystemConfigVersion  @relation("DeploymentConfigVersion", fields: [configVersionId], references: [id])
  previousConfigVersion   SystemConfigVersion? @relation("DeploymentPreviousVersion", fields: [previousConfigVersionId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model KnowledgeConversation {
  id        String          @id @db.Uuid
  tenantId  String
  userId    String
  title     String
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  turns     KnowledgeTurn[]

  @@index([tenantId, userId, updatedAt])
}

model KnowledgeTurn {
  id             String                @id @db.Uuid
  conversationId String                @db.Uuid
  question       String                @db.Text
  answer         String                @db.Text
  noAnswer       Boolean
  reason         String?
  answerMode     String?
  traceId        String                @unique @db.Uuid
  sources        Json
  model          Json?
  rerankDegraded Boolean               @default(false)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  conversation   KnowledgeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

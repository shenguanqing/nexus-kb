{
  "name": "nexus-kb",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:css": "stylelint \"apps/web/src/**/*.{css,scss,vue}\" --fix",
    "lint": "pnpm -r --if-present lint && node scripts/check-secrets.mjs",
    "lint:css": "stylelint \"apps/web/src/**/*.{css,scss,vue}\"",
    "postinstall": "pnpm --filter @nexus-kb/api db:generate",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "10.9.2",
    "globals": "^16.5.0",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.7.0",
    "stylelint": "^17.14.1",
    "stylelint-order": "^8.1.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vue-eslint-parser": "10.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}

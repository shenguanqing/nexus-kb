{
  "name": "nexus-kb",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:css": "stylelint \"apps/web/src/**/*.{css,scss,vue}\" --fix",
    "docker:base": "node scripts/compose.mjs base",
    "docker:dev": "node scripts/compose.mjs dev",
    "docker:oidc": "node scripts/compose.mjs oidc",
    "docker:full": "node scripts/compose.mjs full",
    "docker:full:db": "node scripts/compose.mjs full-db",
    "docker:production": "node scripts/compose.mjs production",
    "docker:up:dev": "node scripts/compose.mjs dev up -d --build",
    "docker:up:all": "node scripts/compose.mjs full up -d --build",
    "docs:check": "prettier --check \"**/*.md\" && node scripts/check-docs.mjs",
    "lint": "pnpm -r --if-present lint && node scripts/check-secrets.mjs && pnpm docs:check",
    "lint:css": "stylelint \"apps/web/src/**/*.{css,scss,vue}\"",
    "postinstall": "pnpm --filter @nexus-kb/api db:generate",
    "production:check": "node scripts/production-preflight.mjs",
    "production:compose:check": "node scripts/production-compose-policy.mjs",
    "production:init": "node scripts/create-production-env.mjs",
    "production:backup": "node scripts/production-backup.mjs",
    "production:restore": "node scripts/production-restore.mjs",
    "test": "node --test scripts/*.test.mjs && pnpm -r --if-present test",
    "test:parser": "pnpm docker:base -- --profile test run --rm --build parser-worker-tests",
    "smoke:ingestion": "node scripts/smoke-ingestion.mjs",
    "quality:baseline": "node scripts/run-quality-baseline.mjs",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "10.9.2",
    "globals": "^16.5.0",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.7.0",
    "stylelint": "^17.14.1",
    "stylelint-order": "^8.1.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vue-eslint-parser": "10.4.1"
  },
  "pnpm": {
    "overrides": {
      "@fastify/ajv-compiler>fast-uri": "3.1.5",
      "@nestjs/platform-fastify>find-my-way": "9.7.0",
      "@prisma/config>deepmerge-ts": "8.0.0",
      "@vue/compiler-sfc>postcss": "8.5.23",
      "ajv>fast-uri": "3.1.5",
      "fast-json-stringify>fast-uri": "4.1.2",
      "fastify>find-my-way": "9.7.0",
      "postcss>nanoid": "3.3.18",
      "vite>postcss": "8.5.23"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}

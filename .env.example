# Node 运行环境；production 会启用更严格的认证与网络默认值。
NODE_ENV=development
# API 进程在容器内监听的地址；Compose 仍只将端口发布到宿主机回环地址。
API_HOST=0.0.0.0
# API 进程在容器内监听的 TCP 端口。
API_PORT=3000
# Pino 最低日志级别；不得以 debug 日志记录敏感正文。
LOG_LEVEL=info

# PostgreSQL 初始化用户名；只在空 postgres_data volume 首次启动时生效。
POSTGRES_USER=kb
# PostgreSQL 初始化密码；复制后必须替换为本地随机值，且不得提交。
POSTGRES_PASSWORD=replace-with-a-local-database-password
# PostgreSQL 初始化数据库名；只在空 postgres_data volume 首次启动时生效。
POSTGRES_DB=kb
# API 连接 PostgreSQL 的 URL；密码必须与 POSTGRES_PASSWORD 保持一致并进行必要的 URL 编码。
DATABASE_URL=postgresql://kb:replace-with-a-local-database-password@postgres:5432/kb
# API 连接 Redis/BullMQ 的 URL。
REDIS_URL=redis://redis:6379

# API 通过 Compose 内网访问 Parser Worker 的基础 URL。
PARSER_WORKER_URL=http://parser-worker:8000
# API 与 Parser Worker（以及默认本地 Reranker）共享的内部认证 token；必须替换为至少 16 字符的随机值。
PARSER_INTERNAL_TOKEN=replace-with-a-random-internal-token
# API 等待一次 Parser Worker 请求的最长时间，单位为毫秒。
PARSER_REQUEST_TIMEOUT_MS=240000
# API 可读写原始上传文件的受控容器目录。
RAW_DOCS_PATH=/data/raw-docs
# 是否允许 DWG 上传与转换；默认开启时必须使用 compose.dwg.yaml 构建 ODA Worker。
DWG_CONVERSION_ENABLED=true
# Worker 内 ODA 转换器的绝对、非符号链接可执行文件路径。
DWG_CONVERTER_EXECUTABLE=/usr/local/bin/nexus-oda-file-converter
# 写入解析器版本与审计记录的实际 ODA 版本；构建后按 dpkg-query 结果填写。
DWG_CONVERTER_RELEASE=replace-with-oda-version
# ODA 生成 DXF 时使用的目标 AutoCAD 版本。
DWG_OUTPUT_VERSION=ACAD2018
# 单个 DWG 转换允许的最长时间，单位为秒。
DWG_CONVERSION_TIMEOUT_SECONDS=180
# Worker 私有临时解析目录；运行在受限 tmpfs 中。
PARSER_TEMP_PATH=/tmp/parser
# 单个 DWG 转换产物允许的最大字节数。
MAX_DWG_CONVERTED_BYTES=209715200
# Worker 接受的单个待解析文件最大字节数。
MAX_PARSE_BYTES=52428800
# 单个文档允许返回的最大结构化元素数。
MAX_ELEMENTS=100000
# 单个电子表格允许处理的最大行数。
MAX_SPREADSHEET_ROWS=100000
# 单张 CAD 图纸允许遍历的最大实体数。
MAX_CAD_ENTITIES=1000000
# CAD INSERT 块引用允许的最大递归深度。
MAX_CAD_INSERT_DEPTH=8
# 压缩文件允许的最大条目数，用于防御压缩炸弹。
MAX_ARCHIVE_ENTRIES=10000
# 压缩文件解压后的最大总字节数，用于防御压缩炸弹。
MAX_ARCHIVE_UNCOMPRESSED_BYTES=524288000
# 公共上传接口接受的单个文件最大字节数。
MAX_UPLOAD_BYTES=52428800
# BullMQ 入库任务的并发处理数。
INGESTION_CONCURRENCY=2
# 单个入库任务的最大尝试次数。
INGESTION_MAX_ATTEMPTS=3
# 入库重试指数退避的初始延迟，单位为毫秒。
INGESTION_RETRY_BASE_DELAY_MS=1000
# 离线索引迁移操作：none、prepare 或 activate；日常 API 启动保持 none。
INDEX_MIGRATION_ACTION=none
# 单个文本分块的最大 token 预算。
CHUNK_MAX_TOKENS=600
# 相邻文本分块之间重叠的 token 数。
CHUNK_OVERLAP_TOKENS=80
# 脱敏规则集的版本标识；关键变更需要重建索引。
REDACTION_POLICY_VERSION=v1
# 额外业务脱敏正则规则的 JSON 数组；不得包含真实业务数据。
BUSINESS_REDACTION_RULES_JSON=[]
# 是否允许 confidential 内容调用云端服务；默认必须保持 false。
ALLOW_CONFIDENTIAL_TO_CLOUD=false
# 已审批云端出网规则的 JSON 数组；空数组表示不额外放行。
CLOUD_EGRESS_RULES_JSON=[]

# 文档和查询 Embedding 提供商：none、alibaba 或受控本机 ollama。
EMBEDDING_PROVIDER=none
# 当前 Embedding 模型 ID；文档与查询必须使用相同模型。
EMBEDDING_MODEL=text-embedding-v4
# 当前 Embedding 向量维度；变更时必须创建新 collection。
EMBEDDING_DIMENSIONS=1024
# 单次发送给 Embedding 提供商的最大文本数。
EMBEDDING_BATCH_SIZE=10
# 文档与查询 Embedding 的任务模式；当前仅支持 symmetric。
EMBEDDING_TASK_MODE=symmetric
# Embedding 数据区域标签，用于策略判断和审计。
EMBEDDING_REGION=cn-beijing
# 单次 Embedding 请求超时，单位为毫秒。
EMBEDDING_REQUEST_TIMEOUT_MS=60000
# Embedding 可重试错误的最大尝试次数。
EMBEDDING_MAX_ATTEMPTS=3
# Embedding 重试指数退避的初始延迟，单位为毫秒。
EMBEDDING_RETRY_BASE_DELAY_MS=500
# 阿里云百炼 API Key；仅在使用 alibaba Embedding 或 Provider 时填写。
DASHSCOPE_API_KEY=
# 阿里云百炼 OpenAI-compatible 基础 URL。
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 阿里云百炼数据区域标签。
ALIBABA_REGION=cn-beijing
# Docker 中 API 访问宿主机受控 Ollama 服务的基础 URL。
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 主 LLM 提供商：none、openai、google、deepseek、alibaba 或 custom。
LLM_PROVIDER=none
# 主 LLM 的实际可用模型 ID；启用非 none 提供商时必须填写。
LLM_MODEL=
# 可选 LLM 备用提供商；仅在可重试故障时切换。
LLM_FALLBACK_PROVIDER=none
# 备用 LLM 的实际可用模型 ID；启用备用提供商时必须填写。
LLM_FALLBACK_MODEL=
# LLM 生成温度，取值范围由 schema 限制为 0 至 2。
LLM_TEMPERATURE=0.2
# 单次 LLM 回答允许生成的最大 token 数。
LLM_MAX_OUTPUT_TOKENS=1200
# 单次 LLM 请求超时，单位为毫秒。
LLM_REQUEST_TIMEOUT_MS=90000
# LLM 可重试错误的最大尝试次数。
LLM_MAX_ATTEMPTS=3
# LLM 重试指数退避的初始延迟，单位为毫秒。
LLM_RETRY_BASE_DELAY_MS=500
# OpenAI API Key；仅在 OpenAI Provider 被选用时填写。
OPENAI_API_KEY=
# OpenAI API 的 HTTPS 基础 URL。
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI 数据区域标签。
OPENAI_REGION=global
# Google Gemini API Key；仅在 Google Provider 被选用时填写。
GEMINI_API_KEY=
# Google Gemini API 的 HTTPS 基础 URL。
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Google Gemini 数据区域标签。
GEMINI_REGION=global
# DeepSeek API Key；仅在 DeepSeek Provider 被选用时填写。
DEEPSEEK_API_KEY=
# DeepSeek API 的 HTTPS 基础 URL。
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 数据区域标签。
DEEPSEEK_REGION=global
# 自定义 OpenAI-compatible Provider 的 API Key。
CUSTOM_API_KEY=
# 自定义 OpenAI-compatible Provider 的 HTTPS 基础 URL。
CUSTOM_BASE_URL=
# 自定义 Provider 的数据区域标签。
CUSTOM_REGION=

# 重排提供商：none、alibaba 或受控本地 local_bge。
RERANK_PROVIDER=none
# 重排模型 ID；local_bge 必须使用批准的 BAAI/bge-reranker-v2-m3。
RERANK_MODEL=qwen3-rerank
# 阿里云 Rerank 的专用 HTTPS 基础 URL；不复用 Chat/Embedding endpoint。
RERANK_BASE_URL=
# Rerank 数据区域标签。
RERANK_REGION=cn-beijing
# API 访问 Compose 内网本地 Reranker 的基础 URL。
LOCAL_RERANK_BASE_URL=http://reranker-worker:8100
# 本地 Reranker 专用内部 token；留空时复用 PARSER_INTERNAL_TOKEN，启用时有效 token 必须至少 16 字符。
RERANK_INTERNAL_TOKEN=
# 是否启动本地 Reranker 的实际模型服务。
LOCAL_RERANK_ENABLED=false
# 本地 Reranker 下载/加载的固定模型 revision；生产环境必须使用获批 revision。
LOCAL_RERANK_MODEL_REVISION=main
# 本地 Reranker 每批候选文本数。
LOCAL_RERANK_BATCH_SIZE=8
# 重排后保留的候选数，同时作为最终上下文上限。
RERANK_TOP_K=5
# 单次 Rerank 请求超时，单位为毫秒。
RERANK_REQUEST_TIMEOUT_MS=60000
# Provider 与模型价格表的 JSON 对象，用于估算 USD 成本；空对象表示不估算。
MODEL_PRICING_USD_PER_MILLION_TOKENS_JSON={}
# ACL 预过滤后的向量召回数量，且不得超过 CHROMA_QUERY_MAX_TOP_K。
QUERY_RECALL_TOP_K=20
# Cosine distance 拒答阈值；数值越小越严格。
QUERY_MAX_DISTANCE=0.45
# 无足够知识库依据时的回答策略：hybrid 允许标记通用回答，strict 则拒答。
QUERY_ANSWER_MODE=hybrid
# 合并命中 chunk 时向前、向后读取的 active 邻居数量。
QUERY_NEIGHBOR_WINDOW=1
# 单个合并检索上下文允许的最大字符数。
QUERY_MAX_MERGED_CONTEXT_CHARS=20000
# 单次送入 Rerank 的候选上下文总最大字符数。
QUERY_MAX_RERANK_INPUT_CHARS=120000
# 单个用户每分钟允许的知识问答请求数。
QUERY_USER_RATE_LIMIT_PER_MINUTE=20
# 单个 tenant 每分钟允许的知识问答请求数。
QUERY_TENANT_RATE_LIMIT_PER_MINUTE=200

# 是否强制服务端认证；production 必须为 true。
AUTH_REQUIRED=false
# 是否启用应用托管的账号密码会话；启用时还必须配置 PASSWORD_AUTH_USERS_JSON。
PASSWORD_AUTH_ENABLED=false
# 账号密码会话的有效期，单位为秒。
PASSWORD_AUTH_SESSION_TTL_SECONDS=28800
# 单个账号密码认证窗口内允许的最大失败次数。
PASSWORD_AUTH_MAX_ATTEMPTS=8
# 账号密码认证失败限速窗口，单位为秒。
PASSWORD_AUTH_WINDOW_SECONDS=900
# 账号密码账户的 JSON 数组；真实账号与密码必须通过 Secret Manager 注入，不能写入此文件。
PASSWORD_AUTH_USERS_JSON=[]
# development/test 且未强制认证时使用的本地 tenant ID。
DEV_TENANT_ID=local-dev
# development/test 且未强制认证时使用的本地用户 ID。
DEV_USER_ID=local-user
# development/test 本地身份所属部门。
DEV_DEPARTMENT=general
# development/test 本地身份的默认敏感度。
DEV_SENSITIVITY=internal
# development/test 本地身份的角色 JSON 数组。
DEV_ROLES_JSON=["user"]
# development/test 本地身份可访问敏感度的 JSON 数组。
DEV_ALLOWED_SENSITIVITIES_JSON=["public","internal","confidential"]
# development/test 本地身份能力的 JSON 数组；仅用于本地体验，不能替代生产鉴权。
DEV_CAPABILITIES_JSON=["documents:read","documents:write","documents:delete","audit:read","system:read","access:read","access:write"]
# OIDC 发行者 URL；使用 OIDC 且 AUTH_REQUIRED=true 时必须填写。
OIDC_ISSUER=
# OIDC access token 的目标 audience；使用 OIDC 时必须填写。
OIDC_AUDIENCE=
# OIDC JWKS 公钥集 URL；production 必须使用 HTTPS 且不得嵌入凭据。
OIDC_JWKS_URI=
# OIDC JWT 验签允许的算法 JSON 数组；仅允许批准的非对称算法。
OIDC_ALLOWED_ALGORITHMS_JSON=["RS256"]
# JWT 时间声明允许的时钟偏差，单位为秒。
OIDC_CLOCK_TOLERANCE_SECONDS=5
# 获取 OIDC JWKS 的请求超时，单位为毫秒。
OIDC_JWKS_TIMEOUT_MS=5000

# Chroma Server 的 Compose 内网基础 URL。
CHROMA_URL=http://chroma:8000
# 向量库实现；当前仅支持 chroma。
VECTOR_STORE_PROVIDER=chroma
# Chroma tenant 名称，必须与服务端资源一致。
CHROMA_TENANT=default_tenant
# Chroma database 名称，必须与服务端资源一致。
CHROMA_DATABASE=default_database
# 所有 collection 的稳定名称前缀。
CHROMA_COLLECTION_PREFIX=nexuskb
# Chroma collection schema 版本；变更会使用新的 collection。
CHROMA_SCHEMA_VERSION=1
# 单次 Chroma upsert 的最大向量数。
CHROMA_UPSERT_BATCH_SIZE=100
# Chroma 单次查询允许返回的最大候选数。
CHROMA_QUERY_MAX_TOP_K=100

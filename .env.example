NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

POSTGRES_USER=kb
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=kb
DATABASE_URL=postgresql://kb:replace-with-a-local-database-password@postgres:5432/kb
REDIS_URL=redis://redis:6379

PARSER_WORKER_URL=http://parser-worker:8000
PARSER_INTERNAL_TOKEN=replace-with-a-random-internal-token
PARSER_REQUEST_TIMEOUT_MS=240000
RAW_DOCS_PATH=/data/raw-docs
DWG_CONVERSION_ENABLED=false
DWG_CONVERTER_EXECUTABLE=/opt/oda/ODAFileConverter
DWG_CONVERTER_RELEASE=27.6
DWG_OUTPUT_VERSION=ACAD2018
DWG_CONVERSION_TIMEOUT_SECONDS=180
PARSER_TEMP_PATH=/tmp/parser
MAX_DWG_CONVERTED_BYTES=209715200
MAX_PARSE_BYTES=52428800
MAX_ELEMENTS=100000
MAX_SPREADSHEET_ROWS=100000
MAX_CAD_ENTITIES=200000
MAX_CAD_INSERT_DEPTH=8
MAX_ARCHIVE_ENTRIES=10000
MAX_ARCHIVE_UNCOMPRESSED_BYTES=524288000
MAX_UPLOAD_BYTES=52428800
INGESTION_CONCURRENCY=2
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_BASE_DELAY_MS=1000
INDEX_MIGRATION_ACTION=none
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
REDACTION_POLICY_VERSION=v1
BUSINESS_REDACTION_RULES_JSON=[]
ALLOW_CONFIDENTIAL_TO_CLOUD=false
CLOUD_EGRESS_RULES_JSON=[]

EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TASK_MODE=symmetric
EMBEDDING_REGION=cn-beijing
EMBEDDING_REQUEST_TIMEOUT_MS=60000
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_BASE_DELAY_MS=500
DASHSCOPE_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_REGION=cn-beijing

LLM_PROVIDER=none
LLM_MODEL=
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1200
LLM_REQUEST_TIMEOUT_MS=90000
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_MS=500
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REGION=global
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_REGION=global
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REGION=global
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_REGION=

RERANK_PROVIDER=none
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=
RERANK_REGION=cn-beijing
RERANK_TOP_K=5
RERANK_REQUEST_TIMEOUT_MS=60000
MODEL_PRICING_USD_PER_MILLION_TOKENS_JSON={}
QUERY_RECALL_TOP_K=20
QUERY_MAX_DISTANCE=0.45
QUERY_NEIGHBOR_WINDOW=1
QUERY_MAX_MERGED_CONTEXT_CHARS=20000
QUERY_MAX_RERANK_INPUT_CHARS=120000
QUERY_USER_RATE_LIMIT_PER_MINUTE=20
QUERY_TENANT_RATE_LIMIT_PER_MINUTE=200

AUTH_REQUIRED=false
DEV_TENANT_ID=local-dev
DEV_USER_ID=local-user
DEV_DEPARTMENT=general
DEV_SENSITIVITY=internal
DEV_ROLES_JSON=[]
DEV_ALLOWED_SENSITIVITIES_JSON=["public","internal","confidential"]
DEV_CAPABILITIES_JSON=["documents:read","documents:write","documents:delete","audit:read","system:read","access:read","access:write"]
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_ALLOWED_ALGORITHMS_JSON=["RS256"]
OIDC_CLOCK_TOLERANCE_SECONDS=5
OIDC_JWKS_TIMEOUT_MS=5000

CHROMA_URL=http://chroma:8000
VECTOR_STORE_PROVIDER=chroma
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION_PREFIX=nexuskb
CHROMA_SCHEMA_VERSION=1
CHROMA_UPSERT_BATCH_SIZE=100
CHROMA_QUERY_MAX_TOP_K=100
